# Services
USER_SERVICE_URL=http://user-service:8080
PRODUCT_SERVICE_URL=http://product-service:8081

# MySQL
MYSQL_CONTAINER_NAME=mysql
MYSQL_PORT=3307
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# phpMyAdmin
PHPMYADMIN_CONTAINER_NAME=phpmyadmin
PHPMYADMIN_PMA_HOST=mysql
PHPMYADMIN_PORT=8089
PHPMYADMIN_PMA_PORT=3306

# MongoDB
MONGODB_CONTAINER_NAME=mongodb
MONGODB_PORT=28018
MONGODB_URI=mongodb://mongodb:27017/segundum

# Mongo Express
MONGO_EXPRESS_CONTAINER_NAME=mongo-express
MONGO_EXPRESS_MONGODB_SERVER=mongodb
MONGO_EXPRESS_PORT=8088
MONGO_EXPRESS_MONGODB_PORT=27017
MONGO_EXPRESS_BASICAUTH_USERNAME=
MONGO_EXPRESS_BASICAUTH_PASSWORD=

# RabbitMQ
RABBITMQ_CONTAINER_NAME=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=

# User service
USER_SERVICE_CONTAINER_NAME=user-service
USER_SERVICE_PORT=8080
USER_SERVICE_DATASOURCE_URL=jdbc:mysql://mysql:3306/users?serverTimezone=CET
USER_SERVICE_DATASOURCE_DRIVER=com.mysql.cj.jdbc.Driver
USER_SERVICE_DATASOURCE_USERNAME=
USER_SERVICE_DATASOURCE_PASSWORD=

# Product service
PRODUCT_SERVICE_CONTAINER_NAME=product-service
PRODUCT_SERVICE_PORT=8081
PRODUCT_SERVICE_DATASOURCE_URL=jdbc:mysql://mysql:3306/products?serverTimezone=CET
PRODUCT_SERVICE_DATASOURCE_USERNAME=
PRODUCT_SERVICE_DATASOURCE_PASSWORD=

# Sale service
SALE_SERVICE_CONTAINER_NAME=sale-service
SALE_SERVICE_PORT=8082
SALE_SERVICE_DATASOURCE_URL=jdbc:mysql://mysql:3306/sales?serverTimezone=CET
SALE_SERVICE_DATASOURCE_USERNAME=
SALE_SERVICE_DATASOURCE_PASSWORD=