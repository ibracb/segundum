{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Swagger": {
    "Enabled": false
  },
  "MongoDB": {
    "Uri": "mongodb://localhost:27017",
    "Collection": "ratings"
  },
  "RabbitMQ": {
    "ConnectionString": "amqp://guest:guest@localhost:5672",
    "Exchange": "bus",
    "RoutingKey": "bus.ratings."
  },
  "SaleService": {
    "BaseUrl": "http://localhost:8082/api/sales"
  },
  "API_BASE_URL": "http://localhost:8090"
}
